}
cost_varies <- 10^seq(-2, 1, length = 4)
eps01_fixed <- rep(0.1, 4)
cost_curves <- map2_dfr(
cost_varies,
eps01_fixed,
~ SVM_explore(.x, .y)
)
sinData |>
ggplot(aes(x, y)) +
geom_point(alpha = 0.6) +
geom_line(data = cost_curves, aes(x = x, y = y, linetype = label), linewidth = 1) +
labs(
title = "Effect of Cost on SVM Fit",
x = "x",
y = "Predicted y",
linetype = "Model"
)
eps_varies <- c(0.01, 0.1, 0.5, 1.0)
cost_fixed <- rep(0.1, 4)
eps_curves <- map2_dfr(
cost_fixed,
eps_varies,
~ SVM_explore(.x, .y)
)
sinData |>
ggplot(aes(x, y)) +
geom_point(alpha = 0.6) +
geom_line(data = eps_curves, aes(x = x, y = y, linetype = label), linewidth = 1) +
labs(
title = "Effect of Epsilon on SVM Fit",
x = "x",
y = "Predicted y",
linetype = "Model"
)
SVM_explore3 <- function(cost = 0.1, epsilon = 0.1, sigma = 1,
data_grid = dataGrid, sin_data = sinData) {
svm_fit <- ksvm(
y ~ x,
data = sin_data,
type = "eps-svr",
kernel = "rbfdot",
kpar = list(sigma = sigma),
C = cost,
epsilon = epsilon
)
tibble(
x = data_grid$x,
y = as.numeric(predict(svm_fit, newdata = data_grid)),
label = paste0("sigma = ", round(sigma, 3))
)
}
sigma_varies <- 10^seq(-2, 1, length = 4)
sigma_curves <- map_dfr(
sigma_varies,
~ SVM_explore3(sigma = .x)
)
sinData |>
ggplot(aes(x, y)) +
geom_point(alpha = 0.6) +
geom_line(data = sigma_curves, aes(x = x, y = y, linetype = label), linewidth = 1) +
labs(
title = "Effect of Sigma on SVM Fit",
x = "x",
y = "Predicted y",
linetype = "Model"
)
library(AppliedPredictiveModeling)
data(ChemicalManufacturingProcess)
set.seed(seed)
chem_data <- ChemicalManufacturingProcess
train_index <- createDataPartition(chem_data$Yield, p = 0.80, list = FALSE)
chem_train <- chem_data[train_index, ]
chem_test  <- chem_data[-train_index, ]
x_train <- chem_train |> select(-Yield)
y_train <- chem_train$Yield
x_test <- chem_test |> select(-Yield)
y_test <- chem_test$Yield
pp <- preProcess(
x_train,
method = c("knnImpute", "center", "scale")
)
x_train_pp <- predict(pp, x_train)
x_test_pp <- predict(pp, x_test)
train_pp <- bind_cols(Yield = y_train, x_train_pp)
test_pp <- bind_cols(Yield = y_test, x_test_pp)
ctrl <- trainControl(
method = "repeatedcv",
number = 10,
repeats = 3,
savePredictions = "final"
)
#| cache: true
set.seed(seed)
nnet_grid <- expand.grid(
size = c(1, 3, 5, 7),
decay = c(0, 0.001, 0.01, 0.1)
)
nnet_fit <- train(
Yield ~ .,
data = train_pp,
method = "nnet",
metric = "RMSE",
trControl = ctrl,
tuneGrid = nnet_grid,
trace = FALSE,
linout = TRUE,
maxit = 500
)
set.seed(seed)
mars_grid <- expand.grid(
degree = c(1, 2, 3),
nprune = seq(2, 30, by = 2)
)
mars_fit <- train(
Yield ~ .,
data = train_pp,
method = "earth",
metric = "RMSE",
trControl = ctrl,
tuneGrid = mars_grid
)
set.seed(seed)
svm_fit <- train(
Yield ~ .,
data = train_pp,
method = "svmRadial",
metric = "RMSE",
trControl = ctrl,
tuneLength = 10
)
set.seed(seed)
knn_fit <- train(
Yield ~ .,
data = train_pp,
method = "knn",
metric = "RMSE",
trControl = ctrl,
tuneLength = 20
)
model_list <- list(
Neural_Network = nnet_fit,
MARS = mars_fit,
SVM_Radial = svm_fit,
KNN = knn_fit
)
resamp <- resamples(model_list)
summary(resamp)
resample_rmse <- map_dfr(
names(model_list),
function(model_name) {
best <- model_list[[model_name]]$results |>
filter(RMSE == min(RMSE)) |>
slice(1)
tibble(
Model = model_name,
Resampling_RMSE = best$RMSE,
Resampling_Rsquared = best$Rsquared,
Resampling_MAE = best$MAE
)
}
)
test_rmse <- map_dfr(
names(model_list),
function(model_name) {
pred <- predict(model_list[[model_name]], newdata = test_pp)
out <- postResample(pred = pred, obs = test_pp$Yield)
tibble(
Model = model_name,
Test_RMSE = unname(out["RMSE"]),
Test_Rsquared = unname(out["Rsquared"]),
Test_MAE = unname(out["MAE"])
)
}
)
model_results <- resample_rmse |>
left_join(test_rmse, by = "Model") |>
arrange(Test_RMSE)
kable(model_results, digits = 3)
best_model_name <- model_results$Model[1]
best_model <- model_list[[best_model_name]]
best_model_name
best_imp <- varImp(best_model, scale = TRUE)
best_imp_df <- best_imp$importance |>
as.data.frame() |>
rownames_to_column("Predictor") |>
as_tibble() |>
rename(Importance = Overall) |>
arrange(desc(Importance)) |>
slice(1:10) |>
mutate(
Rank = row_number(),
Variable_Type = if_else(str_detect(Predictor, "^Bio"), "Biological", "Process")
) |>
select(Rank, Predictor, Variable_Type, Importance)
kable(best_imp_df, digits = 3)
best_imp_df |>
count(Variable_Type)
# Replace these names with the top five lasso predictors from Module 3.
# This object is left editable because the exact Module 3 model output is not included in this template.
lasso_top5 <- c("Predictor1", "Predictor2", "Predictor3", "Predictor4", "Predictor5")
nonlinear_top10 <- best_imp_df |>
select(Predictor) |>
mutate(SVM_Rank_1_10 = row_number())
lasso_df <- tibble(
Predictor = lasso_top5,
Lasso_Rank_1_5 = row_number()
)
set.seed(seed)
sinData <- tibble(
x = runif(100, min = 2, max = 10),
y = sin(x) + rnorm(length(x)) * .25
)
outliers <- tibble(
x = c(3.0, 3.5, 4.1, 4.6, 5.0),
y = c(-5, -5, -5, -5, -5)
)
sinData_outlier <- bind_rows(sinData, outliers)
dataGrid <- tibble(x = seq(2, 10, length.out = 200))
fit_svm <- function(cost = 1, epsilon = 0.1, sigma = 1, data = sinData_outlier) {
model <- ksvm(
y ~ x,
data = data,
type = "eps-svr",
kernel = "rbfdot",
kpar = list(sigma = sigma),
C = cost,
epsilon = epsilon
)
tibble(
x = dataGrid$x,
y = as.numeric(predict(model, newdata = dataGrid)),
label = paste0("C = ", cost, ", epsilon = ", epsilon, ", sigma = ", sigma)
)
}
