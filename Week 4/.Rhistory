library(mlbench)
set.seed(200)
simulated <- mlbench.friedman1(200, sd = 1)
simulated <- cbind(simulated$x, simulated$y)
simulated <- as.data.frame(simulated)
colnames(simulated)[ncol(simulated)] <- "y"
set.seed(seed)
model1 <- randomForest(y ~ ., data = simulated, importance = TRUE, ntree = 1000)
importance1 <- varImp(model1)
importance1_df <- importance1 |>
as.data.frame() |>
rownames_to_column("Predictor") |>
as_tibble() |>
rename(Importance = Overall) |>
arrange(desc(Importance))
kable(importance1_df, digits = 3)
simulated$duplicate1 <- simulated$V1 + rnorm(200) * .1
cor(simulated$duplicate1, simulated$V1)
set.seed(seed)
model2 <- randomForest(y ~ ., data = simulated, importance = TRUE, ntree = 1000)
importance2 <- varImp(model2)
importance2_df <- importance2 |>
as.data.frame() |>
rownames_to_column("Predictor") |>
as_tibble() |>
rename(Importance = Overall) |>
arrange(desc(Importance))
importance_compare_1 <- importance1_df |>
select(Predictor, Importance_Model1 = Importance) |>
full_join(
importance2_df |> select(Predictor, Importance_Model2 = Importance),
by = "Predictor"
) |>
filter(Predictor %in% c("V1", "duplicate1"))
kable(importance_compare_1, digits = 3)
simulated$duplicate2 <- simulated$V1 + rnorm(200) * .1
cor(simulated$duplicate2, simulated$V1)
set.seed(seed)
model3 <- randomForest(y ~ ., data = simulated, importance = TRUE, ntree = 1000)
importance3 <- varImp(model3)
importance3_df <- importance3 |>
as.data.frame() |>
rownames_to_column("Predictor") |>
as_tibble() |>
rename(Importance = Overall) |>
arrange(desc(Importance))
importance_compare_2 <- importance1_df |>
select(Predictor, Importance_Model1 = Importance) |>
full_join(
importance2_df |> select(Predictor, Importance_Model2 = Importance),
by = "Predictor"
) |>
full_join(
importance3_df |> select(Predictor, Importance_Model3 = Importance),
by = "Predictor"
) |>
filter(Predictor %in% c("V1", "duplicate1", "duplicate2"))
kable(importance_compare_2, digits = 3)
